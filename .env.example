# ---------------------------------------------------------------------------
# Microsoft Graph (app-only / client credentials)
# Create an Entra ID app registration with the Graph application permission
# Sites.Read.All (admin-consented) and a client secret.
# ---------------------------------------------------------------------------
SP_TENANT_ID=your-tenant-id
SP_CLIENT_ID=your-app-client-id
SP_CLIENT_SECRET=your-app-client-secret

# ---------------------------------------------------------------------------
# Embedding backend (default: azure_openai)
# ---------------------------------------------------------------------------
EMBEDDING_BACKEND=azure_openai
AZURE_EMBEDDING_ENDPOINT=https://YOUR-EMBEDDING-RESOURCE.cognitiveservices.azure.com
AZURE_EMBEDDING_API_KEY=replace-me
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_EMBEDDING_API_VERSION=2023-05-15

# ---------------------------------------------------------------------------
# Chat / LLM backend (default: azure_openai)
# NOTE: gpt-5-chat uses max_completion_tokens, not max_tokens.
# ---------------------------------------------------------------------------
CHAT_BACKEND=azure_openai
AZURE_CHAT_ENDPOINT=https://YOUR-CHAT-RESOURCE.cognitiveservices.azure.com
AZURE_CHAT_API_KEY=replace-me
AZURE_CHAT_DEPLOYMENT=gpt-5-chat
AZURE_CHAT_API_VERSION=2025-01-01-preview

# ---------------------------------------------------------------------------
# Vector store (default: local)
# ---------------------------------------------------------------------------
VECTOR_STORE=local

# ---------------------------------------------------------------------------
# Local working directory for state + vectors
# ---------------------------------------------------------------------------
SP_RAG_HOME=.sp_rag

# Ingest tuning
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
RETRIEVAL_TOP_K=6
